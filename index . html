<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ScholarScope – AI &amp; Plagiarism Research Checker</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f3ec;--card:#fff;--ink:#1d2033;--mute:#5b6078;--line:#e4dfd2;--gold:#c98a1b;--ai:#e2574c;--hum:#1f9d6b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1022;--card:#171b35;--ink:#eceefb;--mute:#a1a7c7;--line:#2a2f55;--gold:#f0b74a;--ai:#ff7a6e;--hum:#3fd596}}
:root[data-theme="dark"]{--bg:#0d1022;--card:#171b35;--ink:#eceefb;--mute:#a1a7c7;--line:#2a2f55;--gold:#f0b74a;--ai:#ff7a6e;--hum:#3fd596}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 Inter,system-ui,sans-serif}
.wrap{max-width:980px;margin:auto;padding:0 16px}
.hero{background:radial-gradient(circle at 80% 30%,#5b3fb4 0,transparent 55%),linear-gradient(135deg,#0f1333,#2a1b5a);color:#fff;padding:34px 0 28px}
.hero .wrap{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;align-items:center}
@media(max-width:700px){.hero .wrap{grid-template-columns:1fr}}
h1{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:clamp(2.1rem,6vw,3.3rem);line-height:1.05;margin:0 0 10px;background:linear-gradient(90deg,#ffd27a,#ff9f68 45%,#5eead4);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{margin:0;color:#d6d9f5;max-width:46ch}
.tabs{display:flex;gap:8px;margin:18px 0}
.btn{background:linear-gradient(90deg,var(--gold),#e8743b);color:#1b1305;border:0;border-radius:10px;padding:11px 18px;font:600 15px Inter,sans-serif;cursor:pointer}
.btn.alt{background:transparent;border:1px solid var(--line);color:var(--ink)}
.btn.on{outline:2px solid var(--gold)}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:16px}
h2{font-family:'Playfair Display',Georgia,serif;margin:0 0 10px;font-size:1.4rem}
.drop{border:2px dashed var(--gold);border-radius:14px;padding:18px;text-align:center;cursor:pointer;margin-bottom:12px}
.drop small,.note{color:var(--mute);font-size:.88rem}
textarea,input[type=text]{width:100%;background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:10px;font:inherit}
textarea{min-height:170px;resize:vertical}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;align-items:center}
.bar{display:flex;height:30px;border-radius:99px;overflow:hidden;margin:10px 0}
.bar i{display:flex;align-items:center;justify-content:center;color:#fff;font:600 13px Inter;font-style:normal;transition:width .6s}
.big{display:flex;justify-content:space-between;font-size:1.6rem;font-weight:700}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
.stat{border:1px solid var(--line);border-radius:12px;padding:10px}.stat b{display:block;font-size:1.35rem}.stat span{color:var(--mute);font-size:.85rem}
.warn{border-left:4px solid var(--gold);padding:8px 12px;background:rgba(201,138,27,.1);border-radius:6px;font-size:.9rem;margin:10px 0}
ul{padding-left:18px;margin:6px 0}li{margin:4px 0}a{color:var(--gold)}
.star{background:none;border:0;font-size:28px;cursor:pointer;color:var(--line);padding:0 2px}.star.on{color:var(--gold)}
.rev{border-top:1px solid var(--line);padding:10px 0}
.hide{display:none}
</style></head><body>
<header class="hero"><div class="wrap"><div>
<h1>ScholarScope</h1>
<p>Upload or paste your research text to get an AI vs. human writing estimate, a plagiarism helper, and handy research stats.</p></div>
<svg viewBox="0 0 320 200" role="img" aria-label="Illustration of stacked scholarly books with a graduation cap" xmlns="http://www.w3.org/2000/svg">
<defs><radialGradient id="g" cx="50%" cy="60%" r="60%"><stop offset="0" stop-color="#ffd27a" stop-opacity=".55"/><stop offset="1" stop-color="#ffd27a" stop-opacity="0"/></radialGradient></defs>
<ellipse cx="160" cy="120" rx="150" ry="90" fill="url(#g)"/>
<rect x="30" y="150" width="200" height="30" rx="4" fill="#7c3aed"/><rect x="30" y="160" width="200" height="4" fill="#ffd27a"/><rect x="40" y="170" width="170" height="4" fill="#fff" opacity=".7"/>
<rect x="50" y="120" width="170" height="30" rx="4" fill="#0e9f8e"/><rect x="50" y="130" width="170" height="4" fill="#ffd27a"/>
<rect x="38" y="92" width="190" height="28" rx="4" fill="#e2574c"/><rect x="38" y="101" width="190" height="4" fill="#ffd27a"/>
<rect x="60" y="66" width="150" height="26" rx="4" fill="#2563eb"/><rect x="60" y="74" width="150" height="4" fill="#ffd27a"/>
<rect x="240" y="70" width="22" height="110" rx="3" fill="#f59e0b"/><rect x="264" y="88" width="20" height="92" rx="3" fill="#10b981"/><rect x="286" y="60" width="22" height="120" rx="3" fill="#ec4899"/>
<polygon points="135,18 195,38 135,58 75,38" fill="#111827"/><path d="M105 48v16q30 14 60 0V48l-30 10z" fill="#1f2937"/><line x1="195" y1="38" x2="195" y2="62" stroke="#ffd27a" stroke-width="3"/><circle cx="195" cy="64" r="4" fill="#ffd27a"/>
</svg></div></header>
<main class="wrap">
<nav class="tabs"><button class="btn on" id="t-analyzer" data-v="analyzer">Analyzer</button><button class="btn alt" id="t-reviews" data-v="reviews">Reviews</button></nav>

<section id="analyzer">
<div class="card"><h2>1. Add your text</h2>
<label class="drop" for="file"><b>Attach a file</b><br><small>.pdf, .docx, .txt or .md · text-based PDFs up to 80 pages (scanned image PDFs can’t be read)</small></label>
<input id="file" type="file" accept=".pdf,.docx,.txt,.md" class="hide">
<textarea id="txt" placeholder="…or paste your research text here (at least 150 words gives a more meaningful estimate)"></textarea>
<div class="row"><button class="btn" id="go">Analyze text</button><button class="btn alt" id="clr">Clear</button><span class="note" id="msg"></span></div>
<div class="warn">Estimate only, not proof. No AI detector is fully reliable, and all can produce false positives. Please don’t use this score alone to judge anyone’s work.</div></div>

<div id="out" class="hide">
<div class="card"><h2>2. AI vs. human estimate</h2>
<div class="big"><span style="color:var(--hum)">Human <span id="hp"></span>%</span><span style="color:var(--ai)">AI <span id="ap"></span>%</span></div>
<div class="bar"><i id="bh" style="background:var(--hum)"></i><i id="ba" style="background:var(--ai)"></i></div>
<p class="note" id="conf"></p><ul id="sig"></ul>
<div class="row"><button class="btn alt hide" id="cl">Ask Claude for a second opinion</button></div><div id="clo" class="note"></div>
<p class="note"><b>Not a validated detector.</b> This percentage comes from a simple on-device heuristic (sentence-length variation, stock AI-style phrases, repetitive transition openers, sentence-length uniformity). It has not been tested against any benchmark dataset, so its error rates are unknown. OpenAI withdrew its own AI text classifier in 2023 for low accuracy, and researchers have reported that such tools mislabel non-native English writing more often. Never use this number as evidence against a person.</p></div>

<div class="card"><h2>3. Plagiarism helper</h2><p id="pl"></p>
<ul id="pls"></ul><b>Check against the web</b>
<p class="note">This page has no access to a plagiarism database, so it cannot give a real similarity score. These links search your longest sentences as exact phrases so you can check them yourself. For a formal check, use a licensed service such as the one your institution provides (for example Turnitin or iThenticate).</p><ul id="lnk"></ul></div>

<div class="card"><h2>4. Research tools</h2><div class="stats" id="st"></div>
<p><b>Top keywords:</b> <span id="kw"></span></p></div>
</div></section>

<section id="reviews" class="hide">
<div class="card"><h2>Leave a review</h2>
<div id="stars" aria-label="Rating"></div>
<input type="text" id="rn" maxlength="40" placeholder="Your name (optional)" style="margin:8px 0">
<textarea id="rt" maxlength="600" style="min-height:90px" placeholder="What worked well? What should be improved?"></textarea>
<div class="row"><button class="btn" id="rs">Submit review</button><span class="note" id="rm"></span></div></div>
<div class="card"><h2>What people say <span class="note" id="avg"></span></h2><p class="note" id="mode"></p><div id="rl"></div></div>
</section>
<p class="note" style="text-align:center;margin:24px 0">The built-in analysis runs in your browser. Your text is sent to Claude only if you click “Ask Claude for a second opinion”.</p>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])),clamp=(x,a,b)=>Math.min(b,Math.max(a,x));
const PH=["delve","moreover","furthermore","in conclusion","it is important to note","crucial role","tapestry","multifaceted","underscore","comprehensive","leverage","pivotal","ever-evolving","navigate the","realm","holistic","robust","foster","shed light","notably","paramount","intricate","a testament to"];
const OPEN=["however","moreover","furthermore","additionally","overall","consequently","thus","therefore","ultimately","notably"];
const STOP=new Set("the and for that this with are was were from have has had not but which their these those its our can may also been such than into more most other some will would could about between through using used use one two".split(" "));
const syl=w=>{const m=w.replace(/e$/,"").match(/[aeiouy]+/g);return Math.max(1,m?m.length:1)};
const sd=a=>{const m=a.reduce((x,y)=>x+y,0)/a.length;return Math.sqrt(a.reduce((x,y)=>x+(y-m)**2,0)/a.length)};
let lastText="";
function analyze(raw){
 const t=raw.replace(/[’‘]/g,"'").replace(/\s+/g," ").trim(),low=t.toLowerCase();
 const W=low.match(/[a-z'-]+/g)||[],n=W.length;
 const S=(t.match(/[^.!?]+[.!?]+/g)||[t]).map(s=>s.trim()).filter(s=>s.split(" ").length>2);
 const L=S.map(s=>s.split(" ").length),mean=L.reduce((a,b)=>a+b,0)/(L.length||1),burst=mean?sd(L)/mean:0;
 const hits=PH.filter(p=>low.includes(p)),hitCount=PH.reduce((c,p)=>c+(low.split(p).length-1),0),dens=hitCount/Math.max(n,1)*1000;
 const op=S.filter(s=>OPEN.includes(s.toLowerCase().split(/\W+/)[0])).length/(S.length||1);
 const s1=clamp((0.6-burst)/0.3,0,1)*40,s2=clamp(dens/6,0,1)*35,s3=clamp(op/0.2,0,1)*15,s4=(mean>=17&&mean<=27)?10:0;
 const ai=Math.round(clamp(s1+s2+s3+s4,0,100));
 const sy=W.reduce((a,w)=>a+syl(w),0),fl=206.835-1.015*(n/(S.length||1))-84.6*(sy/Math.max(n,1));
 const cit=(t.match(/\([A-Z][A-Za-z-]+(?: et al\.)?,? (?:19|20)\d\d[a-z]?\)/g)||[]).length+(t.match(/\[\d+(?:[,–-]\s*\d+)*\]/g)||[]).length;
 const doi=(t.match(/10\.\d{4,9}\/\S+/g)||[]).length;
 const f={};W.forEach(w=>{if(w.length>3&&!STOP.has(w))f[w]=(f[w]||0)+1});
 const kw=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8).map(e=>e[0]+" ("+e[1]+")");
 const SW=S.map(s=>s.toLowerCase().match(/[a-z'-]+/g)||[]),cnt={};
 SW.forEach(w=>{for(let i=0;i+7<=w.length;i++){const k=w.slice(i,i+7).join(" ");cnt[k]=(cnt[k]||0)+1}});
 const rep=S.filter((s,j)=>{const w=SW[j];for(let i=0;i+7<=w.length;i++)if(cnt[w.slice(i,i+7).join(" ")]>1)return true;return false});
 const long=S.map((s,j)=>[s,SW[j]]).filter(x=>x[1].length>=12).sort((a,b)=>b[1].length-a[1].length).slice(0,6);
 return{n,S,mean,burst,hits,dens,op,ai,fl,cit,doi,kw,rep,long,uniq:new Set(W).size,chars:t.length};
}
function run(){
 const raw=$("#txt").value;lastText=raw;const A=analyze(raw);
 if(A.n<50){$("#msg").textContent="Please provide at least 50 words.";return}
 $("#msg").textContent="";$("#out").classList.remove("hide");
 const ai=A.ai,hu=100-ai;$("#ap").textContent=ai;$("#hp").textContent=hu;
 $("#bh").style.width=hu+"%";$("#ba").style.width=ai+"%";$("#bh").textContent=hu>12?hu+"%":"";$("#ba").textContent=ai>12?ai+"%":"";
 $("#conf").textContent=A.n<150?"Very low confidence: the text is under 150 words.":A.n<400?"Low confidence: short texts give unstable estimates.":"Low to moderate confidence at best: treat this as one clue, not a verdict.";
 $("#sig").innerHTML=[
  "Sentence-length variation: "+A.burst.toFixed(2)+" (lower variation is treated as a mild AI signal)",
  "Stock AI-style phrases: "+A.dens.toFixed(1)+" per 1,000 words"+(A.hits.length?" ("+esc(A.hits.slice(0,5).join(", "))+")":""),
  "Sentences opening with transition words: "+Math.round(A.op*100)+"%",
  "Average sentence length: "+A.mean.toFixed(1)+" words"].map(x=>"<li>"+x+"</li>").join("");
 const pct=Math.round(A.rep.length/(A.S.length||1)*100);
 $("#pl").textContent=A.rep.length?pct+"% of sentences ("+A.rep.length+" of "+A.S.length+") contain a 7-word run that appears more than once in this text.":"No repeated 7-word runs found inside this text.";
 $("#pls").innerHTML=A.rep.slice(0,5).map(s=>"<li>"+esc(s.slice(0,160))+"…</li>").join("");
 $("#lnk").innerHTML=A.long.length?A.long.map(([s,w])=>{const q=encodeURIComponent('"'+w.slice(0,14).join(" ")+'"');return"<li>“"+esc(w.slice(0,10).join(" "))+"…” – <a target=\"_blank\" rel=\"noopener\" href=\"https://scholar.google.com/scholar?q="+q+"\">Google Scholar</a> · <a target=\"_blank\" rel=\"noopener\" href=\"https://www.google.com/search?q="+q+"\">Google</a></li>"}).join(""):"<li>No sentences long enough to search.</li>";
 const st=[[A.n,"Words"],[A.S.length,"Sentences"],[Math.max(1,Math.round(A.n/230))+" min","Reading time (~230 wpm)"],[A.fl.toFixed(0),"Flesch reading ease"],[(A.uniq/Math.max(A.n,1)*100).toFixed(0)+"%","Unique words"],[A.cit,"Citations detected"],[A.doi,"DOIs detected"],[A.chars,"Characters"]];
 $("#st").innerHTML=st.map(x=>"<div class=\"stat\"><b>"+x[0]+"</b><span>"+x[1]+"</span></div>").join("");
 $("#kw").textContent=A.kw.join(", ")||"–";$("#clo").textContent="";
 $("#out").scrollIntoView({behavior:"smooth"});
}
$("#go").onclick=run;$("#clr").onclick=()=>{$("#txt").value="";$("#out").classList.add("hide");$("#msg").textContent=""};
$("#file").onchange=async e=>{
 const f=e.target.files[0];if(!f)return;$("#msg").textContent="Reading "+f.name+"…";
 try{let t;
  if(/\.pdf$/i.test(f.name)){if(!window.pdfjsLib)throw 0;pdfjsLib.GlobalWorkerOptions.workerSrc="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";const d=await pdfjsLib.getDocument({data:new Uint8Array(await f.arrayBuffer()),isEvalSupported:false}).promise;const P=[];for(let i=1;i<=Math.min(d.numPages,80);i++){const c=await(await d.getPage(i)).getTextContent();P.push(c.items.map(x=>x.str).join(" "))}t=P.join("\n\n");if(t.trim().length<50){$("#msg").textContent="No readable text found. Is this a scanned PDF?";return}}else if(/\.docx$/i.test(f.name)){if(!window.mammoth)throw 0;t=(await mammoth.extractRawText({arrayBuffer:await f.arrayBuffer()})).value}
  else if(/\.(txt|md)$/i.test(f.name))t=await f.text();else throw 0;
  $("#txt").value=t;$("#msg").textContent="Loaded "+f.name;
 }catch(x){$("#msg").textContent="Couldn’t read that file. Please paste the text instead."}
};
function show(v){["analyzer","reviews"].forEach(k=>{$("#"+k).classList.toggle("hide",k!==v);$("#t-"+k).classList.toggle("alt",k!==v);$("#t-"+k).classList.toggle("on",k===v)});try{location.hash=v}catch(e){}}
document.querySelectorAll(".tabs .btn").forEach(b=>b.onclick=()=>show(b.dataset.v));
show(location.hash==="#reviews"?"reviews":"analyzer");

/* Reviews */
let rating=0,db=null,local=[];
try{local=JSON.parse(localStorage.getItem("ss_reviews")||"[]")}catch(e){}
$("#stars").innerHTML=[1,2,3,4,5].map(i=>"<button class=\"star\" data-i=\""+i+"\" aria-label=\""+i+" stars\">★</button>").join("");
document.querySelectorAll(".star").forEach(b=>b.onclick=()=>{rating=+b.dataset.i;document.querySelectorAll(".star").forEach(x=>x.classList.toggle("on",+x.dataset.i<=rating))});
function renderReviews(list){
 const a=list.length?(list.reduce((x,r)=>x+(+r.rating||0),0)/list.length).toFixed(1):null;
 $("#avg").textContent=a?"· average "+a+"/5 from "+list.length:"";
 $("#rl").innerHTML=list.length?list.map(r=>"<div class=\"rev\"><b>"+esc(r.name||"Anonymous")+"</b> <span style=\"color:var(--gold)\">"+"★".repeat(+r.rating||0)+"</span><br>"+esc(r.text||"")+"</div>").join(""):"<p class=\"note\">No reviews yet. Be the first!</p>";
}
$("#mode").textContent="Showing reviews saved on this device.";renderReviews(local);
$("#rs").onclick=async()=>{
 const text=$("#rt").value.trim();if(!rating||!text){$("#rm").textContent="Please choose a star rating and write a comment.";return}
 const r={name:$("#rn").value.trim().slice(0,40),rating,text:text.slice(0,600),ts:Date.now()};
 try{if(db)await db.collection("reviews").add(r);else throw 0}
 catch(e){local.unshift(r);try{localStorage.setItem("ss_reviews",JSON.stringify(local.slice(0,50)))}catch(x){}renderReviews(local)}
 $("#rt").value="";$("#rn").value="";$("#rm").textContent="Thank you for your feedback!";
};

/* Optional capabilities: shared reviews and Claude second opinion */
(async()=>{
 try{if(!window.claude)return;
  const d=await claude.use("db");
  if(d){db=d;$("#mode").textContent="Shared reviews from people who opened this page.";d.collection("reviews").orderBy("ts","desc").limit(50).onSnapshot(s=>renderReviews(s.docs.map(x=>x.data())),()=>{})}
  const sm=await claude.use("sample");
  if(sm){$("#cl").classList.remove("hide");$("#cl").onclick=async()=>{
   $("#clo").textContent="Asking Claude…";
   try{const r=await sm.json("You are giving a cautious second opinion on whether a text was written by AI. Return ONLY JSON: {\"ai_percent\": number 0-100, \"reasons\": [up to 4 short strings], \"caveat\": string}. Be conservative and say in the caveat how unreliable this judgment is. TEXT:\n"+lastText.slice(0,6000),{cache:false});
    $("#clo").innerHTML="<b>Claude’s opinion: about "+esc(Math.round(+r.ai_percent))+"% AI.</b> This is a judgment, not proof.<ul>"+(r.reasons||[]).map(x=>"<li>"+esc(x)+"</li>").join("")+"</ul>"+esc(r.caveat||"");
   }catch(e){$("#clo").textContent="Claude’s second opinion isn’t available right now."}}}
 }catch(e){}
})();
</script></body></html>
